#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"

build_dir="${CAELESTIA_LAB_BUILD_DIR:-${repo_root}/build}"
install_prefix="${CAELESTIA_LAB_INSTALL_PREFIX:-/tmp/caelestia-shell-install}"
qs_config_dir="${CAELESTIA_LAB_QS_CONFIG_DIR:-/tmp/caelestia-test}"

cmake -S "${repo_root}" -B "${build_dir}" -G Ninja \
    -DCMAKE_BUILD_TYPE="${CAELESTIA_LAB_BUILD_TYPE:-Debug}" \
    -DCMAKE_INSTALL_PREFIX=/ \
    -DINSTALL_QSCONFDIR="${qs_config_dir}"

cmake --build "${build_dir}"
cmake --install "${build_dir}" --prefix "${install_prefix}"

if [[ -f "${qs_config_dir}/shell.qml" ]]; then
    sed -i '/^\/\/@ pragma DefaultEnv /d' "${qs_config_dir}/shell.qml"
fi

printf 'Lab shell installed at %s\n' "${qs_config_dir}"
printf 'Lab QML modules installed at %s/usr/lib/qt6/qml\n' "${install_prefix}"
